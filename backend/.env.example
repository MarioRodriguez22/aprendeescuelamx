PORT=3000
DB_PATH=./data/aprende-escuela-mx.sqlite
# auto prueba Gemini, Groq y Ollama local; no pasa a proveedores de pago salvo que se habilite.
AI_PROVIDER=auto
# Las cuotas gratuitas dependen de cada proveedor y pueden cambiar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision
# OpenAI y Anthropic pueden generar cargos; solo se usan automaticamente si activas esta opcion.
AI_ALLOW_PAID_FALLBACK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
MAX_UPLOAD_MB=10
FRONTEND_ORIGIN=http://localhost:5173
# Cuenta reservada de administración; llena ambos valores para habilitar el panel.
ADMIN_USERNAME=
ADMIN_PASSWORD=